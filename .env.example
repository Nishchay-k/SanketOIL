# Local development. The default Compose credentials are only for your machine.
APP_ENV=development
PORT=8000
DATABASE_URL=postgresql+psycopg://nwis:nwis-dev-password@localhost:5432/sanket
DATASET_LABEL=synthetic-development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Use demo mode locally. Production Render config switches this to Supabase Auth.
AUTH_MODE=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Local document storage for development; Render production uses Supabase Storage.
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=sanket-documents
MAX_UPLOAD_BYTES=12582912

# Sample records only belong in development. Never enable this with live operations data.
SEED_DEMO_DATA=true
AUTO_CREATE_SCHEMA=true

# Optional local sentence-transformers model. No AI model is bundled.
NWIS_EMBEDDING_MODEL=
VECTOR_DIMENSIONS=384
STREAM_POLL_SECONDS=2

# Build-time development fallbacks. Runtime config is fetched from FastAPI in production.
VITE_API_BASE_URL=
VITE_AUTH_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
